{
    "name": "crown-rwa-platform",
    "version": "1.0.0",
    "description": "Ecosistema de contratos inteligentes para tokenización de real estate - BytePeak Technology",
    "main": "index.js",
    "scripts": {
        "compile": "forge compile",
        "test": "forge test -vvv",
        "test:fuzz": "forge test --fuzz-runs 5000",
        "coverage": "forge coverage",
        "coverage:report": "forge coverage --report lcov && genhtml lcov.info -o coverage-report",
        "deploy:local": "forge script contracts/script/DeployAll.s.sol:DeployAll --rpc-url http://localhost:8545 --broadcast",
        "deploy:sepolia": "source .env && forge script contracts/script/DeployAll.s.sol:DeployAll --rpc-url $ARBITRUM_SEPOLIA_RPC_URL --broadcast --verify --chain arbitrum-sepolia --etherscan-api-key $ARBISCAN_API_KEY",
        "sync": "tsx sync-contracts.ts",
        "pipeline:ship": "npm run compile && npm run deploy:sepolia && npm run sync",
        "format": "prettier --write contracts/src/**/*.sol contracts/script/**/*.sol contracts/test/**/*.sol",
        "lint": "solhint contracts/src/**/*.sol"
    },
    "keywords": [
        "solidity",
        "web3",
        "foundry",
        "rwa",
        "real-estate",
        "tokenization"
    ],
    "author": "BytePeak Technology",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^26.1.1",
        "prettier": "^3.2.5",
        "prettier-plugin-solidity": "^1.3.1",
        "solhint": "^6.2.3",
        "tsx": "^4.19.0",
        "typescript": "^5.5.0"
    },
    "dependencies": {
        "@openzeppelin/contracts": "^5.6.1"
    }
}
